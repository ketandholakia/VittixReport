procedure TQrCodeTests.Test_Vector_DecoderValidated_HTTPS;
{
  Authoritative vector: the expected matrix below was produced by the encoder
  under test and then INDEPENDENTLY verified by decoding it with a third-party
  QR decoder (OpenCV QRCodeDetector), which returned the exact payload.
  This pins version, mask and the full module matrix.
}
const
  ExpectedVersion = 2;
  ExpectedMask = 1;
  Expected: array [0..24] of string = (
    '1111111011100000001111111',
    '1000001001010111001000001',
    '1011101010100100101011101',
    '1011101001110001001011101',
    '1011101001000011001011101',
    '1000001010001111101000001',
    '1111111010101010101111111',
    '0000000000000100000000000',
    '1010001100011100000100101',
    '1010010111111001101111001',
    '0111001101010111010010101',
    '1110110101101011010001001',
    '0011101100100110101011110',
    '0000000111000111010001001',
    '1111001111010001011001010',
    '0010110010100101000010010',
    '1101101101111101111110011',
    '0000000011101001100011111',
    '1111111011001111101010111',
    '1000001000111010100011110',
    '1011101001000111111110100',
    '1011101001000110000110000',
    '1011101010110001010111011',
    '1000001000000100000110101',
    '1111111011111100100010111');
var
  M: TBarcodeModuleMatrix;
  X, Y: Integer;
begin
  M := EncodeQRMatrix('HTTPS://EXAMPLE.COM/QR-4H2', qrMedium);
  Assert.IsTrue(M.Version = ExpectedVersion, Format('version=%d', [M.Version]));
  Assert.IsTrue(M.Mask = ExpectedMask, Format('mask=%d', [M.Mask]));
  Assert.IsTrue(M.Size = 25, Format('size=%d', [M.Size]));
  for Y := 0 to 24 do
    for X := 0 to 24 do
      Assert.IsTrue(M.IsDark(X, Y) = (Expected[Y][X + 1] = '1'),
        Format('module mismatch at %d,%d', [X, Y]));
end;

initialization
  TDUnitX.RegisterTestFixture(TQrCodeTests);

end.
