procedure TQrCodeTests.Test_Vector_UTF8_ByteMode;
var
  M1, M2: TBarcodeModuleMatrix;
  X, Y, I: Integer;
begin
  // Pure byte-mode UTF-8 payload (no QR alphanumeric characters), 22 bytes.
  // The library segments/encodes this with its own (valid) optimization, so
  // a bit-exact comparison against segno's plain byte encoding does not
  // apply; correctness is verified structurally and by determinism.
  M1 := EncodeQRMatrix('ÄÖÜ-äöü-ß-中文', qrMedium);
  Assert.IsTrue(M1.Size = 4 * M1.Version + 17, Format('size=%d version=%d',
    [M1.Size, M1.Version]));
  // The library's auto-segmentation splits mixed-script UTF-8 into several
  // byte segments (each carrying its own header), so the chosen version can
  // be larger than a single-segment encoder would need.  It must stay within
  // version 4 (33x33) for a 22-byte payload.
  Assert.IsTrue((M1.Size >= 25) and (M1.Size <= 33),
    Format('22 UTF-8 bytes must fit versions 2..4, size=%d', [M1.Size]));
  Assert.IsTrue((M1.Mask >= 0) and (M1.Mask <= 7));

  // Determinism.
  M2 := EncodeQRMatrix('ÄÖÜ-äöü-ß-中文', qrMedium);
  Assert.IsTrue(M1.Size = M2.Size);
  Assert.IsTrue(M1.Version = M2.Version);
  Assert.IsTrue(M1.Mask = M2.Mask);
  for Y := 0 to M1.Size - 1 do
    for X := 0 to M1.Size - 1 do
      Assert.IsTrue(M1.IsDark(X, Y) = M2.IsDark(X, Y));

  // Structural: finder patterns at all three corners.
  for I := 0 to 6 do
  begin
    Assert.IsTrue(M1.IsDark(I, 0) and M1.IsDark(0, I) and M1.IsDark(I, 6) and
      M1.IsDark(6, I), 'top-left finder edge');
    Assert.IsTrue(M1.IsDark(M1.Size - 7 + I, 0) and M1.IsDark(M1.Size - 1, I),
      'top-right finder edge');
    Assert.IsTrue(M1.IsDark(0, M1.Size - 7 + I) and M1.IsDark(I, M1.Size - 1),
      'bottom-left finder edge');
  end;
end;

