unit Test.Vittix.Report.Objects.QR;

{
  Phase 4H-2: QR Code symbology tests.

  Expected matrices are authoritative reference vectors produced by an
  independent QR implementation (segno 1.6.6, standard QR Model 2), stored
  per mask pattern.  The library under test selects its own (valid) mask
  and optimizes segments automatically (numeric/alphanumeric/byte), so each
  vector test compares against the reference matrix for the library's
  chosen mask and version.
}

interface

uses
  DUnitX.TestFramework,
  System.SysUtils,
  Vcl.Graphics,
  System.Types,
  System.UITypes,
  Vittix.Report.Context,
  Vittix.Report.Objects,
  Vittix.Report.Objects.Barcode;

type
  [TestFixture]
  TQrCodeTests = class
  private
    function DrawQR(const AValue: string; AEcc: TReportQRErrorCorrection): TBitmap;
    procedure CheckVector(const M: TBarcodeModuleMatrix;
      const Rows: array of string; ASize: Integer);
  public
    [Test] procedure Test_EnumValues_Appended;
    [Test] procedure Test_DefaultErrorCorrection_IsMedium;
    [Test] procedure Test_EmptyString_EmptyMatrix;
    [Test] procedure Test_SingleChar_Version1;
    [Test] procedure Test_StructuralInvariants_FindersAndTiming;
    [Test] procedure Test_FormatInformation_Present;
    [Test] procedure Test_Deterministic;
    [Test] procedure Test_AllEccLevels_ValidAndDistinct;
    [Test] procedure Test_NumericPayload_Version1;
    [Test] procedure Test_NearCapacity_HigherVersion;
    [Test] procedure Test_LargePayload_HigherVersion;
    [Test] procedure Test_Serializer_RoundTripsErrorCorrection;
    [Test] procedure Test_Object_Draws_QR;
    [Test] procedure Test_Object_EmptyQR_DrawsNothing;
    [Test] procedure Test_QRMatrixToRects_MatchesMatrix;
    [Test] procedure Test_Vector_HELLO_WORLD_1M;
    [Test] procedure Test_Vector_AB1234567890_1M;
    [Test] procedure Test_Vector_UTF8_ByteMode;
    [Test] procedure Test_Vector_Numeric20_1Q;
    [Test] procedure Test_Vector_DecoderValidated_HTTPS;
  end;

implementation

uses
  System.Classes,
  System.StrUtils,
  System.Math,
  Vittix.Report.Bands,
  Vittix.Report.Model,
  Vittix.Report.Serializer;


function TQrCodeTests.DrawQR(const AValue: string; AEcc: TReportQRErrorCorrection): TBitmap;
var
  Obj: TReportBarcodeObject;
  Ctx: TExpressionContext;
begin
  Result := TBitmap.Create;
  try
    Result.SetSize(220, 60);
    Result.Canvas.Brush.Color := clWhite;
    Result.Canvas.FillRect(Rect(0, 0, 220, 60));
    Obj := TReportBarcodeObject.Create;
    try
      Obj.Bounds := Rect(10, 10, 220, 60);
      Obj.Value := AValue;
      Obj.Symbology := bsQR;
      Obj.ErrorCorrection := AEcc;
      Obj.ShowText := False;
      Ctx := Default(TExpressionContext);
      Obj.Draw(Result.Canvas, Ctx);
    finally
      Obj.Free;
    end;
  except
    Result.Free;
    raise;
  end;
end;

procedure TQrCodeTests.CheckVector(const M: TBarcodeModuleMatrix;
  const Rows: array of string; ASize: Integer);
var
  X, Y, Base: Integer;
begin
  Assert.IsTrue((M.Mask >= 0) and (M.Mask <= 7), Format('mask=%d', [M.Mask]));
  Assert.IsTrue(M.Size = ASize, Format('size=%d expected=%d', [M.Size, ASize]));
  Base := M.Mask * ASize;
  for Y := 0 to ASize - 1 do
    for X := 0 to ASize - 1 do
      Assert.IsTrue(M.IsDark(X, Y) = (Rows[Base + Y][X + 1] = '1'),
        Format('module mismatch at %d,%d (mask=%d)', [X, Y, M.Mask]));
end;

function CountDarkPixels(ABmp: TBitmap): Integer;
var
  X, Y: Integer;
begin
  Result := 0;
  for Y := 14 to 40 do
    for X := 10 to 219 do
      if ABmp.Canvas.Pixels[X, Y] = clBlack then
        Inc(Result);
end;

procedure TQrCodeTests.Test_EnumValues_Appended;
var
  Obj: TReportBarcodeObject;
begin
  // Existing ordinals must be unchanged; bsQR appended.
  Assert.IsTrue(Ord(bsLegacy) = 0);
  Assert.IsTrue(Ord(bsCode39) = 1);
  Assert.IsTrue(Ord(bsCode128) = 2);
  Assert.IsTrue(Ord(bsEAN13) = 3);
  Assert.IsTrue(Ord(bsQR) = 4);
  Obj := TReportBarcodeObject.Create;
  try
    Assert.IsTrue(Obj.Symbology = bsLegacy, 'default symbology must stay bsLegacy');
    Assert.IsTrue(Obj.ErrorCorrection = qrMedium, 'default ECC must be qrMedium');
  finally
    Obj.Free;
  end;
end;

procedure TQrCodeTests.Test_DefaultErrorCorrection_IsMedium;
var
  Obj: TReportBarcodeObject;
begin
  Obj := TReportBarcodeObject.Create;
  try
    Obj.ErrorCorrection := qrHigh;
    Assert.IsTrue(Obj.ErrorCorrection = qrHigh);
    Obj.ErrorCorrection := qrLow;
    Assert.IsTrue(Obj.ErrorCorrection = qrLow);
  finally
    Obj.Free;
  end;
end;

procedure TQrCodeTests.Test_EmptyString_EmptyMatrix;
var
  M: TBarcodeModuleMatrix;
begin
  M := EncodeQRMatrix('', qrMedium);
  Assert.IsTrue(M.Size = 0, 'empty payload must yield an empty matrix');
end;

procedure TQrCodeTests.Test_SingleChar_Version1;
var
  M: TBarcodeModuleMatrix;
begin
  M := EncodeQRMatrix('x', qrMedium);
  Assert.IsTrue(M.Size = 21, Format('size=%d', [M.Size])); // 4*1+17
end;

procedure TQrCodeTests.Test_StructuralInvariants_FindersAndTiming;
  procedure CheckFinder(const M: TBarcodeModuleMatrix; OX, OY: Integer);
  var
    I, J: Integer;
  begin
    // 7x7 finder: dark border ring with 3x3 dark center, separated by a
    // light ring from the data area.
    for I := 0 to 6 do
    begin
      Assert.IsTrue(M.IsDark(OX + I, OY), 'finder top edge');
      Assert.IsTrue(M.IsDark(OX + I, OY + 6), 'finder bottom edge');
      Assert.IsTrue(M.IsDark(OX, OY + I), 'finder left edge');
      Assert.IsTrue(M.IsDark(OX + 6, OY + I), 'finder right edge');
    end;
    for I := 1 to 5 do
    begin
      Assert.IsFalse(M.IsDark(OX + I, OY + 1), 'finder light ring');
      Assert.IsFalse(M.IsDark(OX + I, OY + 5), 'finder light ring');
      Assert.IsFalse(M.IsDark(OX + 1, OY + I), 'finder light ring');
      Assert.IsFalse(M.IsDark(OX + 5, OY + I), 'finder light ring');
    end;
    for I := 2 to 4 do
      for J := 2 to 4 do
        Assert.IsTrue(M.IsDark(OX + I, OY + J), 'finder center 3x3');
  end;

var
  M: TBarcodeModuleMatrix;
  I: Integer;
begin
  M := EncodeQRMatrix('HELLO WORLD', qrMedium);
  Assert.IsTrue(M.Size = 21);
  CheckFinder(M, 0, 0);
  CheckFinder(M, 14, 0);
  CheckFinder(M, 0, 14);
  // Timing patterns: row 6 / column 6 alternate between the finders; the
  // first timing module (index 8) is dark, so dark when the index is even.
  for I := 8 to 12 do
  begin
    Assert.IsTrue(M.IsDark(I, 6) = not Odd(I), Format('timing row col=%d', [I]));
    Assert.IsTrue(M.IsDark(6, I) = not Odd(I), Format('timing col row=%d', [I]));
  end;
end;

procedure TQrCodeTests.Test_FormatInformation_Present;
var
  M: TBarcodeModuleMatrix;
  I, DarkBits: Integer;
begin
  M := EncodeQRMatrix('HELLO WORLD', qrMedium);
  // Format information copies surround the top-left finder (row 8 / col 8)
  // and must contain both dark and light modules.
  DarkBits := 0;
  for I := 0 to 8 do
  begin
    if M.IsDark(I, 8) then
      Inc(DarkBits);
    if M.IsDark(8, I) then
      Inc(DarkBits);
  end;
  Assert.IsTrue((DarkBits > 0) and (DarkBits < 30),
    Format('format info bits dark=%d', [DarkBits]));
end;

procedure TQrCodeTests.Test_Deterministic;
var
  A, B: TBarcodeModuleMatrix;
  X, Y: Integer;
begin
  A := EncodeQRMatrix('Determinism check payload', qrMedium);
  B := EncodeQRMatrix('Determinism check payload', qrMedium);
  Assert.IsTrue(A.Size = B.Size);
  Assert.IsTrue(A.Mask = B.Mask, 'mask differs between runs');
  for Y := 0 to A.Size - 1 do
    for X := 0 to A.Size - 1 do
      Assert.IsTrue(A.IsDark(X, Y) = B.IsDark(X, Y),
        Format('matrix differs at %d,%d', [X, Y]));
end;

procedure TQrCodeTests.Test_AllEccLevels_ValidAndDistinct;
var
  M: array[0..3] of TBarcodeModuleMatrix;
  X, Y, I, Differences, DarkCount: Integer;
begin
  M[0] := EncodeQRMatrix('x', qrLow);
  M[1] := EncodeQRMatrix('x', qrMedium);
  M[2] := EncodeQRMatrix('x', qrQuartile);
  M[3] := EncodeQRMatrix('x', qrHigh);
  for I := 0 to 3 do
  begin
    Assert.IsTrue(M[I].Size = 21, Format('ecc %d size=%d', [I, M[I].Size]));
    DarkCount := 0;
    for Y := 0 to M[I].Size - 1 do
      for X := 0 to M[I].Size - 1 do
        if M[I].IsDark(X, Y) then
          Inc(DarkCount);
    Assert.IsTrue((DarkCount > 0) and (DarkCount < M[I].Size * M[I].Size),
      Format('ecc %d dark=%d', [I, DarkCount]));
  end;
  // Different ECC levels differ at least in their format information, so
  // the matrices cannot be identical.
  Differences := 0;
  for Y := 0 to M[0].Size - 1 do
    for X := 0 to M[0].Size - 1 do
      if M[0].IsDark(X, Y) <> M[1].IsDark(X, Y) then
        Inc(Differences);
  Assert.IsTrue(Differences > 0, Format(
    'L and M matrices unexpectedly identical (maskL=%d maskM=%d)',
    [M[0].Mask, M[1].Mask]));
end;

procedure TQrCodeTests.Test_NumericPayload_Version1;
var
  M: TBarcodeModuleMatrix;
begin
  M := EncodeQRMatrix('1234567890', qrMedium);
  Assert.IsTrue(M.Size = 21, Format('size=%d', [M.Size]));
end;

procedure TQrCodeTests.Test_NearCapacity_HigherVersion;
var
  M: TBarcodeModuleMatrix;
begin
  // 50 digits must leave the smallest symbols behind; the structural size
  // must always satisfy 4*version+17.
  M := EncodeQRMatrix('12345678901234567890123456789012345678901234567890', qrMedium);
  Assert.IsTrue(M.Size = 4 * M.Version + 17, Format('size=%d version=%d',
    [M.Size, M.Version]));
  Assert.IsTrue(M.Size >= 25, Format('size=%d', [M.Size]));
end;

procedure TQrCodeTests.Test_LargePayload_HigherVersion;
var
  M: TBarcodeModuleMatrix;
begin
  M := EncodeQRMatrix('https://vittix.example/report?id=42', qrMedium);
  Assert.IsTrue(M.Size = 4 * M.Version + 17, Format('size=%d version=%d',
    [M.Size, M.Version]));
  Assert.IsTrue(M.Size >= 25, Format('size=%d', [M.Size]));
end;

procedure TQrCodeTests.Test_Serializer_RoundTripsErrorCorrection;
var
  M1, M2: TReportModel;
  Band: TReportBand;
  Obj, Loaded: TReportBarcodeObject;
  Json: string;
begin
  M1 := TReportModel.Create;
  try
    Band := TReportBand.Create;
    Band.BandType := btPageHeader;
    Obj := TReportBarcodeObject.Create;
    Obj.Name := 'qr1';
    Obj.Symbology := bsQR;
    Obj.ErrorCorrection := qrHigh;
    Band.Children.Add(Obj);
    M1.Objects.Add(Band);

    Json := TReportSerializer.SaveToJSON(M1);
    M2 := TReportSerializer.LoadFromJSON(Json);
    try
      Loaded := TReportBand(M2.Objects[0]).Children[0] as TReportBarcodeObject;
      Assert.IsTrue(Loaded.Symbology = bsQR);
      Assert.IsTrue(Loaded.ErrorCorrection = qrHigh);
      Loaded.ErrorCorrection := qrLow;
      Assert.IsTrue(Loaded.ErrorCorrection = qrLow);
    finally
      M2.Free;
    end;
  finally
    M1.Free;
  end;
end;

procedure TQrCodeTests.Test_Object_Draws_QR;
var
  Bmp: TBitmap;
begin
  Bmp := DrawQR('HELLO WORLD', qrMedium);
  try
    Assert.IsTrue(CountDarkPixels(Bmp) > 100,
      'QR symbology produced no modules through TReportBarcodeObject.Draw');
  finally
    Bmp.Free;
  end;
end;

procedure TQrCodeTests.Test_Object_EmptyQR_DrawsNothing;
var
  Bmp: TBitmap;
begin
  Bmp := DrawQR('', qrMedium);
  try
    Assert.IsTrue(CountDarkPixels(Bmp) = 0,
      Format('empty QR drew %d dark pixels', [CountDarkPixels(Bmp)]));
  finally
    Bmp.Free;
  end;
end;

procedure TQrCodeTests.Test_QRMatrixToRects_MatchesMatrix;
var
  M: TBarcodeModuleMatrix;
  Rects: TArray<TRect>;
  X, Y, I, DarkCount, Covered, Module, AvailableH: Integer;
begin
  M := EncodeQRMatrix('HELLO WORLD', qrMedium);
  Rects := QRMatrixToRects(M, Rect(10, 10, 220, 60), 14, 44, 202);
  Assert.IsTrue(Length(Rects) > 10);
  // Module size must be derived exactly as QRMatrixToRects derives it:
  // available height 30 (BarTop..BarBottom), width 202; 21+4 total modules.
  AvailableH := 44 - 14;
  Module := Max(1, Min(202 - 4, AvailableH) div (M.Size + 4));
  DarkCount := 0;
  for Y := 0 to M.Size - 1 do
    for X := 0 to M.Size - 1 do
      if M.IsDark(X, Y) then
        Inc(DarkCount);
  // Merged runs must cover exactly the dark modules (no gaps, no overlaps):
  // total covered pixel area = DarkCount * Module^2.
  Covered := 0;
  for I := 0 to High(Rects) do
    Covered := Covered +
      (Rects[I].Right - Rects[I].Left) * (Rects[I].Bottom - Rects[I].Top);
  Assert.IsTrue(Covered = DarkCount * Module * Module,
    Format('covered=%d expected=%d module=%d',
      [Covered, DarkCount * Module * Module, Module]));
  // Rects are generated row-major; the first run starts at the matrix
  // origin (row 0, col 0 is the dark finder corner).
  Assert.IsTrue(Rects[0].Left = 10 + 4 + (202 - Module * M.Size) div 2,
    Format('originX=%d', [Rects[0].Left]));
  Assert.IsTrue(Rects[0].Top = 14 + (30 - Module * M.Size) div 2 + 2 * Module,
    Format('originY=%d', [Rects[0].Top]));
end;
