<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{B5C6D7E8-F9A0-1B2C-3D4E-5F6A7B8C9D0E}</ProjectGuid>
        <ProjectVersion>20.0</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>VittixReportTests.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Console</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>.\dcu\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>.\Win32\$(Config)</DCC_ExeOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_UnitSearchPath>..;..\source;..\source\ThirdParty\QRCodeGenLib\src\QRCodeGen;..\source\ThirdParty\QRCodeGenLib\src\Interfaces;..\source\ThirdParty\QRCodeGenLib\src\Utils;..\source\ThirdParty\QRCodeGenLib\src\Include;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="VittixReportTests.dpr">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Engine.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Undo.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Objects.Chart.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Serializer.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Expressions.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Characterization.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Objects.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Component.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Objects.Barcode.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.Objects.QR.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Report.ExportCapture.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Runner.Options.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="..\Vittix.Runner.Baseline.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Runner.Baseline.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="..\Vittix.Runner.ExportVerification.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
        <DelphiCompile Include="Test.Vittix.Runner.ExportVerification.pas">
            <DCCReference>MainSource</DCCReference>
        </DelphiCompile>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
