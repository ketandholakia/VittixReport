# Uncomment these types if you want even more clean repository. But be careful.
# It can make harm to an existing project source. Read explanations below.
#
# Resource files are binaries containing manifest, project icon and version info.
# They can not be viewed as text or compared by diff-tools. Consider replacing them with .rc files.
#*.res
#
# Type library file (binary). In old Delphi versions it should be stored.
# Since Delphi 2009 it is produced from .ridl file and can safely be ignored.
#*.tlb
#
# Diagram Portfolio file. Used by the diagram editor up to Delphi 7.
# Uncomment this if you are not using diagrams or use newer Delphi version.
#*.ddp
#
# Visual LiveBindings file. Added in Delphi XE2.
# Uncomment this if you are not using LiveBindings Designer.
#*.vlb
#
# Deployment Manager configuration file for your project. Added in Delphi XE2.
# Uncomment this if it is not mobile development and you do not use remote debug feature.
#*.deployproj
#
# C++ object files produced when C/C++ Output file generation is configured.
# Uncomment this if you are not using external objects (zlib library for example).
#*.obj
#

# Default Delphi compiler directories
# Content of this directories are generated with each Compile/Construct of a project.
# Most of the time, files here have not there place in a code repository.
Win32/
Win64/
build/
#OSX64/
#OSXARM64/
#Android/
#Android64/
#iOSDevice64/
#Linux64/

# Delphi compiler-generated binaries (safe to delete)
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.so
*.apk
*.drc
*.map
*.dres
*.rsm
*.tds
*.dcu
*.lib
*.a
*.o
*.ocx

# Delphi autogenerated files (duplicated info)
*.cfg
*.hpp
*Resource.rc

# Delphi local files (user-specific info)
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk

# Delphi history and backups
__history/
__recovery/
*.~*

# Castalia statistics file (since XE7 Castalia is distributed with Delphi)
*.stat

# Boss dependency manager vendor folder https://github.com/HashLoad/boss
modules/

# SQLite temporary files (used by the demo application database)
*.db-shm
*.db-wal

# OS and Editor noise
.DS_Store
Thumbs.db
*.bak

# DUnitX generated output
/tests/VittixReportTests.res
/tests/dunitx-results.xml

# Cline local state
/.cline/
/.vscode/

# Build and verification output (not source)
*.log
/regression_out/
/stub_qr/

# Test run artifacts
/tests/dunitx-results*.xml
/tests/audit_dunitx.xml
/tests/failures*.txt
/tests/*.clean
/tests/*.tmp

# Ad-hoc root-level debugging dumps
/test_*.txt
/test_*.xml
/build_tail.txt
/buildlog_read.txt
/diff_a.txt
/priorresults.txt
/runlist.txt

# Scratch drafts (tracked scratch tooling is unaffected)
/scratch/DesignerControl*.pas
/scratch/controller_draft.pas
/scratch/old_serializer.pas
/scratch/Vittix.Report.DesignerInteractionController.pas
/scratch/ExprProbe.dpr
/scratch/probe.bat
/scratch/git_log_zoomin.txt
/scratch/pkg_*_delta.txt
/scratch/patch_*.py
/scratch/add_bookmarks.py
/scratch/finish_migration.py
/scratch/fix_last.py
/scratch/migrate_mouse.py
/scratch/restore_designer.py

# Local agent/assistant tooling state
/.agents/
/.commandcode/
/.kilo/
/.openclaw/
/.zcode/
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/1788278426566_n6cw8.json

# Assistant attachment staging (screenshots, clipboard dumps, API payloads)
/.openclaw-attachments/

# Ad-hoc local build/test wrappers. The tracked entry points are build.bat,
# RunTests.bat and tools\ci_gate.ps1; these are one-off copies of the same work.
/build_runtime.ps1
/build_runtime_dpk.ps1
/compile_in_temp.ps1
/build_tests_18.cmd
/force_build.bat
/run_tests.bat
/run_tests2.bat

# Ad-hoc icon/DFM scratch tooling and scratch artwork
/rename_icons.py
/test.svg
/vittixdesigner/extract_names.py
/vittixdesigner/patch_dfm.py

# Unreferenced Material Symbols download leftovers in the icon staging folder.
# gen_png_rc.py only emits SVG-backed names, so nothing named *_16dp_* is ever
# compiled into vittix_png_icons.RES or referenced by the designer.
/vittixdesigner/resources/png/*_16dp_*

# Export output written into the regression fixture folder by manual runs
/reports/*.pdf
